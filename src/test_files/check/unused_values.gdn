public fun example() {
  42
  3.14
  "hello"
  [1, 2, 3]
  Dict[]

  10
}

public fun comparisons(n: Int): Bool {
  n
  (n == 2)
  n + 1
  while n < 0 {
    n != 2
    break
  }
  let _ = n == 2
  n == 2
}

fun effect(): Int {
  println("effect")
  1
}

// Expressions containing calls are conservatively skipped.
effect() == 2
[effect()]
Dict[string_repr(effect()) => 1]
Dict["key" => effect()]
(effect(), 1)
Path{ p: string_repr(effect()) }
"hello".len()
assert(comparisons(1) == False)

1 + 2
public fun trailing_definition(): Int { 0 }

