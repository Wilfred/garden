public fun overwritten(): Int {
  let n = 1
  n = 2
  n
}

// Both the initializer and the first assignment are overwritten.
public fun repeated(): Int {
  let n = 1
  n = 2
  n = 3
  n
}

// Reading a value on the right hand side consumes the earlier store.
public fun read_and_update(): Int {
  let n = 1
  n = n + 1
  n += 1
  n
}

public fun overwritten_update(): Int {
  let n = 1
  n += 1
  n = 3
  n
}

public fun destructure(): Int {
  let (n, m) = (1, 2)
  n = 3
  n + m
}

// Shadowing creates a separate binding.
public fun shadow() {
  let _n = 1
  let _n = 2
  assert(_n == 2)
}

// A conditional read must not be confused with an unconditional write.
public fun conditional(flag: Bool): Int {
  let n = 1
  if flag {
    n = 2
  }
  n
}

public fun loop_read(): Int {
  let n = 1
  while n < 2 {
    n = 2
  }
  n
}

// A closure reads the value captured at its creation.
public fun closure_read(): Int {
  let n = 1
  let read = fun(): Int { n }
  n = 2
  assert(read() == 1)
  n = 3
  n
}

// Stores in a branch are still checked locally.
public fun branch_store(flag: Bool): Int {
  if flag {
    let n = 1
    n = 2
    n
  } else {
    0
  }
}

public fun loop_shadow() {
  let n = 1
  assert(n == 1)
  for n in [n = 2] {
    assert(n == Unit)
  }
  assert(n == 2)
}

fun identity(n: Int): Int { n }

public fun call_assignment(): Int {
  let n = 1
  n = identity(2)
  n
}

public fun method_assignment(): Int {
  let n = 1
  n = "hi".len()
  n
}

public fun call_read(): Int {
  let n = 1
  assert(identity(n) == 1)
  n = 2
  n
}

