public fun foo(): Unit {
  // We solve this ambiguity by requiring braces to touch for struct
  // literals.
  while SomeStruct{} {}

  while SomeValue {}

  // This is therefore a syntax error, because SomeValue cannot be a
  // struct literal.
  {}
}

