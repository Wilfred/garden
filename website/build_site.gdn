import "__prelude.gdn" as prelude
import "__fs.gdn" as fs
import "__reflect.gdn" as reflect
import "__random.gdn" as random
import "__shell.gdn" as shell
import "__time.gdn" as time
import "./markdown.gdn" as markdown
import "./log.gdn" as log
import "./operators.gdn" as ops

// ---------------------------------------------------------------------
// Generic helpers
// ---------------------------------------------------------------------

/// Return `items` with `opt` appended, if it is `Some`.
fun append_some<T>(items: List<T>, opt: Option<T>): List<T> {
  match opt {
    Some(v) => items.append(v)
    None => items
  }
}

/// Join `items` into a readable prose sentence: `["a", "b", "c"]`
/// becomes `"a, b and c."`.
fun join_with_commas_and(items: List<String>): String {
  match items.last() {
    None => ""
    Some(last) => {
      let rest = items.slice(0, -1)
      if rest.is_empty() {
        last
      } else {
        ", ".join(rest) ^ " and " ^ last ^ "."
      }
    }
  }
}

test join_with_commas_and {
  assert(join_with_commas_and([]) == "")
  assert(join_with_commas_and(["a"]) == "a")
  assert(join_with_commas_and(["a", "b"]) == "a and b.")
  assert(join_with_commas_and(["a", "b", "c"]) == "a, b and c.")
}

/// A markdown link whose text is shown as code: `` [`text`](url) ``.
fun code_link(text: String, url: String): String {
  "[`" ^ text ^ "`](" ^ url ^ ")"
}

/// Drop the leading comment and blank lines from a source snippet, so
/// documentation shows the interesting code first.
fun drop_leading_comments(src: String): String {
  let lines = src.lines()

  let i = 0
  while i < lines.len() {
    let line = lines.get(i).or_throw()
    if line.starts_with("//") || (line == "") {
      i += 1
    } else {
      break
    }
  }

  "\n".join(lines.slice(i, lines.len()))
}

test drop_leading_comments {
  assert(drop_leading_comments("// a\n// b\ncode\nmore") == "code\nmore")
  assert(drop_leading_comments("code") == "code")
}

// ---------------------------------------------------------------------
// Pages
// ---------------------------------------------------------------------

/// A single output page. `body` is markdown that will be rendered and
/// wrapped in the site template before being written to `dest`.
struct Page {
  dest: Path,
  title: Option<String>,
  body: String,
  source: Option<Path>,
  self_url: Option<String>,
}

/// Render this page to a complete HTML document using `template`.
method render(this: Page, template: String): String {
  let content = markdown::render(this.body, this.source, this.self_url)

  let title = match this.title {
    Some(t) => t ^ " - Garden"
    None => "Garden"
  }
  let filled = template.replace("__TITLE", title)

  let (header, footer) = match filled.split_once("__MAIN_CONTENT") {
    Some(parts) => parts
    None => ("", "")
  }

  "".join([header.trim_right(), content, footer.trim_left()])
}

/// Render this page and write it to disk.
method write(this: Page, template: String): Unit {
  fs::write_file(this.render(template), this.dest).or_throw()
}

/// The page title implied by a markdown file name, so that
/// `keyword:if.md` is titled `if` and `operator:slash.md` is `/`.
fun page_title(file_name: String): Option<String> {
  match file_name.split_once(":") {
    None => None
    Some((kind, rest)) => {
      let name = rest.strip_suffix(".md")
      if kind == "keyword" {
        Some(name)
      } else if kind == "operator" {
        Some(ops::from_url_safe_name(name))
      } else {
        None
      }
    }
  }
}

test page_title {
  assert(page_title("index.md") == None)
  assert(page_title("keyword:if.md") == Some("if"))
  assert(page_title("operator:slash.md") == Some("/"))
}

// ---------------------------------------------------------------------
// Markdown pages
// ---------------------------------------------------------------------

fun markdown_pages(website_dir: Path, out_dir: Path, subs: Dict<String>): List<Page> {
  let pages: List<Page> = []

  for md_path in fs::list_directory(website_dir).or_throw() {
    if md_path.extension() != Some("md") {
      continue
    }

    let file_name = match md_path.file_name() {
      Some(n) => n
      None => continue
    }

    let src = match fs::read_file(md_path) {
      Ok(s) => s
      Err(e) => {
        log::warn("Could not read " ^ md_path.p ^ ": " ^ e)
        continue
      }
    }

    let out_path = out_dir.join(file_name).set_extension("html")

    pages = pages.append(Page{
      dest: out_path,
      title: page_title(file_name),
      body: apply_substitutions(src, subs),
      source: Some(md_path),
      self_url: Some("/" ^ out_path.file_name().or_throw()),
    })
  }

  pages
}

/// Replace every `__PLACEHOLDER` in `src` with its expansion.
fun apply_substitutions(src: String, subs: Dict<String>): String {
  let result = src
  for (placeholder, replacement) in subs.items() {
    result = result.replace(placeholder, replacement)
  }

  result
}

/// A prose list of links to every function in `ns`.
fun namespace_links(ns_name: String, ns: Namespace): String {
  let links = reflect::namespace_functions(ns).map(fun(name: String) {
    code_link(name ^ "()", "./fun:" ^ ns_name ^ "::" ^ name ^ ".html")
  })
  join_with_commas_and(links)
}

/// The `__PLACEHOLDER` expansions used in hand-written markdown pages.
fun build_substitutions(
  website_dir: Path,
  namespaces: List<(String, String, Namespace)>,
): Dict<String> {
  let subs: Dict<String> = Dict[]

  let keyword_links = reflect::keywords().map(fun(k: String) {
    code_link(k, "./keyword:" ^ k ^ ".html")
  })
  subs = subs.set("__KEYWORDS", join_with_commas_and(keyword_links))

  let operator_links = reflect::operators().map(fun(op: String) {
    code_link(op, "./operator:" ^ ops::url_safe_name(op) ^ ".html")
  })
  subs = subs.set("__OPERATORS", join_with_commas_and(operator_links))

  let type_links = reflect::prelude_types().map(fun(t: String) {
    code_link(t, "./type:" ^ t ^ ".html")
  })
  subs = subs.set("__BUILT_IN_TYPES", join_with_commas_and(type_links))

  for (ns_name, placeholder, ns) in namespaces {
    subs = subs.set(placeholder, namespace_links(ns_name, ns))
  }

  subs = subs.set("__BLOG_LINKS", "\n".join(blog_index_links(website_dir)))

  subs
}

// ---------------------------------------------------------------------
// Blog
// ---------------------------------------------------------------------

struct BlogPost {
  path: Path,
  published: Bool,
  title: Option<String>,
  date: Option<String>,
  body: String,
}

/// Split a leading ```metadata block off the front of `src`, returning
/// the metadata block (if present) and the remaining markdown.
fun split_metadata(src: String): (Option<String>, String) {
  let start = "```metadata\n"
  let end = "\n```\n"

  if not(src.starts_with(start)) {
    return (None, src)
  }

  match src.strip_prefix(start).split_once(end) {
    Some((meta, rest)) => (Some(meta), rest)
    None => (None, src)
  }
}

test split_metadata {
  assert(split_metadata("no metadata") == (None, "no metadata"))
  assert(
    split_metadata("```metadata\npublished: true\n```\nbody\n")
      == (Some("published: true"), "body\n"))
}

fun parse_blog_post(path: Path): Option<BlogPost> {
  let src = match fs::read_file(path) {
    Ok(s) => s
    Err(e) => {
      log::warn("Could not read " ^ path.p ^ ": " ^ e)
      return None
    }
  }

  let (metadata, body) = split_metadata(src)

  let published = False
  let title: Option<String> = None
  let date: Option<String> = None

  for line in metadata.or_value("").lines() {
    if line == "published: true" {
      published = True
    } else if line.starts_with("title: ") {
      title = Some(line.strip_prefix("title: "))
    } else if line.starts_with("date: ") {
      date = Some(line.strip_prefix("date: "))
    }
  }

  Some(BlogPost{
    path: path,
    published: published,
    title: title,
    date: date,
    body: body,
  })
}

/// Every parseable blog post, published or not.
fun blog_posts(website_dir: Path): List<BlogPost> {
  let posts: List<BlogPost> = []

  for path in fs::list_directory(website_dir.join("blog")).or_throw() {
    if path.extension() != Some("md") {
      continue
    }

    match parse_blog_post(path) {
      Some(post) => { posts = posts.append(post) }
      None => {}
    }
  }

  posts
}

fun published_posts(website_dir: Path): List<BlogPost> {
  blog_posts(website_dir).filter(fun(post: BlogPost) { post.published })
}

fun blog_pages(website_dir: Path, out_dir: Path, subs: Dict<String>): List<Page> {
  published_posts(website_dir).map(fun(post: BlogPost) {
    let body = post.body

    match post.date {
      Some(date) => { body = "*" ^ date ^ "*\n\n" ^ body }
      None => {}
    }
    match post.title {
      Some(title) => { body = "# " ^ title ^ "\n" ^ body }
      None => {}
    }

    let file_name = post.path.file_name().or_throw()
    let out_path = out_dir.join("blog").join(file_name).set_extension("html")

    Page{
      dest: out_path,
      title: post.title,
      body: apply_substitutions(body, subs),
      source: Some(post.path),
      self_url: None,
    }
  })
}

/// Markdown bullet links to every published post, for the blog index.
fun blog_index_links(website_dir: Path): List<String> {
  published_posts(website_dir).map(fun(post: BlogPost) {
    let file_name = post.path.set_extension("html").file_name().or_throw()

    let text = match post.title {
      Some(title) => title
      None => file_name
    }
    text = match post.date {
      Some(date) => text ^ " (" ^ date ^ ")"
      None => text
    }

    "* [" ^ text ^ "](blog/" ^ file_name ^ ")"
  })
}

// ---------------------------------------------------------------------
// Reflected API documentation
// ---------------------------------------------------------------------

/// Wrap a source snippet in a titled, non-checked garden code block.
fun source_block(src: Option<String>): String {
  match src {
    Some(s) => "```garden nocheck title:\"Source Code\"\n" ^ drop_leading_comments(s) ^ "\n```"
    None => ""
  }
}

/// Turn bare code fences in a doc comment into titled example blocks.
fun expand_examples(doc: String): String {
  doc.replace("\n\n```\n", "\n\n```title:Example\n")
}

/// Assemble the markdown body of a documentation page.
fun doc_body(heading: String, doc: String, src: Option<String>, extra: String): String {
  "".join([heading, "\n\n", doc, "\n\n", source_block(src), extra])
}

fun fun_page(ns_name: String, ns: Namespace, name: String, out_dir: Path): Option<Page> {
  let doc = match reflect::doc_comment(ns, name) {
    Some(d) => d
    None => {
      log::warn(ns_name ^ "::" ^ name ^ " has no doc comment.")
      return None
    }
  }

  let qualified = ns_name ^ "::" ^ name
  let heading = if ns_name == "__prelude.gdn" {
    "# `" ^ name ^ "()`"
  } else {
    "# `" ^ qualified ^ "()`"
  }

  let dest = out_dir.join("fun:" ^ qualified ^ ".html")

  Some(Page{
    dest: dest,
    title: Some(name),
    body: doc_body(heading, expand_examples(doc), reflect::source_for_fun(ns, name), ""),
    source: Some(Path{ p: ns_name }),
    self_url: Some("/" ^ dest.file_name().or_throw()),
  })
}

fun type_page(type_name: String, out_dir: Path): Option<Page> {
  let doc = match reflect::doc_comment_for_type(type_name) {
    Some(d) => d
    None => {
      log::warn("No doc comment for built-in type " ^ type_name ^ ".")
      return None
    }
  }

  let heading = "# `" ^ type_name ^ "` type"

  let methods = reflect::methods_for_type(type_name)
  let extra = if methods.is_empty() {
    ""
  } else {
    let method_links = methods.map(fun(m: String) {
      "* [`" ^ m ^ "()`](/method:" ^ type_name ^ "::" ^ m ^ ".html)"
    })
    "\n\n## Methods\n\n" ^ "\n".join(method_links)
  }

  let dest = out_dir.join("type:" ^ type_name ^ ".html")

  Some(Page{
    dest: dest,
    title: Some(type_name),
    body: doc_body(heading, doc, reflect::source_for_type(type_name), extra),
    source: None,
    self_url: Some("/" ^ dest.file_name().or_throw()),
  })
}

fun method_page(type_name: String, method_name: String, out_dir: Path): Option<Page> {
  let doc = match reflect::doc_comment_for_method(type_name, method_name) {
    Some(d) => d
    None => {
      log::warn("Method " ^ type_name ^ "::" ^ method_name ^ " has no doc comment.")
      return None
    }
  }

  let qualified = type_name ^ "::" ^ method_name
  let heading = "# `" ^ qualified ^ "()`"
  let dest = out_dir.join("method:" ^ qualified ^ ".html")

  Some(Page{
    dest: dest,
    title: Some(qualified),
    body: doc_body(heading, expand_examples(doc), reflect::source_for_method(type_name, method_name), ""),
    source: None,
    self_url: Some("/" ^ dest.file_name().or_throw()),
  })
}

fun api_pages(
  website_dir: Path,
  out_dir: Path,
  namespaces: List<(String, String, Namespace)>,
): List<Page> {
  let pages: List<Page> = []

  for (ns_name, _placeholder, ns) in namespaces {
    for name in reflect::namespace_functions(ns) {
      pages = append_some(pages, fun_page(ns_name, ns, name, out_dir))
    }
  }

  for type_name in reflect::prelude_types() {
    // Some types have a hand-written page, e.g. type:Tuple.md, so
    // don't overwrite it with a reflected one.
    if not(website_dir.join("type:" ^ type_name ^ ".md").exists()) {
      pages = append_some(pages, type_page(type_name, out_dir))
    }

    for method_name in reflect::methods_for_type(type_name) {
      pages = append_some(pages, method_page(type_name, method_name, out_dir))
    }
  }

  pages
}

// ---------------------------------------------------------------------
// Static assets
// ---------------------------------------------------------------------

/// Copy images, videos and fonts into `out_dir`. Returns the number of
/// files copied.
fun copy_assets(website_dir: Path, out_dir: Path): Int {
  let copied = 0

  for path in fs::list_directory(website_dir).or_throw() {
    let ext = path.extension()
    if (ext == Some("png")) || (ext == Some("mp4")) {
      let dest = out_dir.join(path.file_name().or_throw())
      fs::copy_file(path, dest).or_throw()
      copied += 1
    }
  }

  let fonts_src = website_dir.join("static").join("fonts")
  let fonts_dest = out_dir.join("static").join("fonts")
  for path in fs::list_directory(fonts_src).or_throw() {
    if path.extension() == Some("woff2") {
      let dest = fonts_dest.join(path.file_name().or_throw())
      fs::copy_file(path, dest).or_throw()
      copied += 1
    }
  }

  copied
}

// ---------------------------------------------------------------------
// Coverage checks
// ---------------------------------------------------------------------

/// Warn about any built-in file that we don't generate documentation
/// for.
fun check_documented(namespaces: List<(String, String, Namespace)>): Unit {
  let documented: List<String> = []
  for (ns_name, _placeholder, _ns) in namespaces {
    documented = documented.append(ns_name)
  }

  for built_in in reflect::built_in_files() {
    if not(documented.contains(built_in)) {
      log::warn("Built-in file " ^ built_in ^ " is not in the namespaces list.")
    }
  }
}

/// Warn about any keyword or operator that has no hand-written page.
fun check_coverage(website_dir: Path): Unit {
  for keyword in reflect::keywords() {
    if not(website_dir.join("keyword:" ^ keyword ^ ".md").exists()) {
      log::warn("Missing documentation page for keyword: " ^ keyword)
    }
  }

  for operator in reflect::operators() {
    let page_name = ops::url_safe_name(operator)
    if not(website_dir.join("operator:" ^ page_name ^ ".md").exists()) {
      log::warn("Missing documentation page for operator: " ^ operator)
    }
  }
}

// ---------------------------------------------------------------------
// Orchestration
// ---------------------------------------------------------------------

/// Create `path` if it does not already exist.
fun ensure_dir(path: Path): Unit {
  match fs::create_dir(path) {
    Ok(_) => {}
    Err(_) => {}
  }
}

/// Build the entire Garden website into `website/dist`.
fun build_site(): Unit {
  let started = time::unixtime()

  let website_dir = reflect::source_file().or_throw().parent().or_throw()
  fs::set_working_directory(website_dir).or_throw()

  let out_dir = website_dir.join("dist")
  ensure_dir(out_dir)
  ensure_dir(out_dir.join("blog"))
  ensure_dir(out_dir.join("static"))
  ensure_dir(out_dir.join("static").join("fonts"))

  let template = fs::read_file(website_dir.join("template.html")).or_throw()

  let namespaces = [
    ("__prelude.gdn", "__PRELUDE_FUNS", prelude),
    ("__fs.gdn", "__FS_FUNS", fs),
    ("__random.gdn", "__RANDOM_FUNS", random),
    ("__reflect.gdn", "__REFLECT_FUNS", reflect),
    ("__shell.gdn", "__SHELL_FUNS", shell),
    ("__time.gdn", "__TIME_FUNS", time),
  ]

  check_documented(namespaces)

  let subs = build_substitutions(website_dir, namespaces)

  let pages: List<Page> = []
  pages = pages.concat(markdown_pages(website_dir, out_dir, subs))
  pages = pages.concat(blog_pages(website_dir, out_dir, subs))
  pages = pages.concat(api_pages(website_dir, out_dir, namespaces))

  for page in pages {
    page.write(template)
  }

  let assets = copy_assets(website_dir, out_dir)

  check_coverage(website_dir)

  let elapsed = time::unixtime() - started
  log::info(
    "Wrote " ^ string_repr(pages.len()) ^ " pages and " ^ string_repr(assets) ^
      " assets in " ^ string_repr(elapsed) ^ "s.")
}

{
  build_site()
}
