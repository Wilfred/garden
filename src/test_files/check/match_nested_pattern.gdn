enum Expr {
  Sym(String),
}

// Nested patterns aren't supported. This should only report a single
// error, not a cascade for every token in the rest of the match.
fun first_sym(exprs: List<Expr>): Option<String> {
  match exprs.first() {
    Some(Sym(head)) => Some(head)
    None => None
  }
}

// args: check
// expected exit status: 1
// expected stdout:
// Error: Expected `)` after this.
