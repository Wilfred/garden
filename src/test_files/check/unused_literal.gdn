public fun example() {
  42
  3.14
  "hello"
  [1, 2, 3]
  Dict[]

  let x = 10
  x
}

fun save(): Unit { println("saved") }
save
println("finished")
let n = 1
n == 2
println(string_repr(n))

public fun comparisons(n: Int): Bool {
  n
  (n == 2)
  n + 1
  while n < 0 {
    n != 2
    break
  }
  n == 2
}

fun effect(): Int {
  println("effect")
  1
}

// These expressions must preserve their calls.
effect() == 2
[effect()]
Dict[string_repr(effect()) => 1]
Dict["key" => effect()]
(effect(), 1)
Path{ p: string_repr(effect()) }
"hello".len()
let _ = n == 2
assert(comparisons(n) == False)

