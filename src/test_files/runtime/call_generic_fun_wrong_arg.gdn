fun my_map<T, U>(items: List<T>, f: Fun<(T), U>): List<U> {
  let result: List<U> = []
  for item in items {
    result = result.append(f(item))
  }
  result
}

{
  my_map([1, 2, 3], fun(s: String) { s })
}

