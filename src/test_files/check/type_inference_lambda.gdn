fun apply_twice<T>(f: Fun<(T), T>, value: T): T {
  f(f(value))
}

{
  [1, 2].filter(fun(_) { True })
  // The lambda parameter x gets its type from the declaration of
  // map, so x is an Int when checking the addition.
  [1, 2, 3].map(fun(x) { x + 1 })
  // The same applies to standalone functions: T is solved from the
  // second argument, so y is an Int.
  apply_twice(fun(y) { y + 1 }, 0)
}

