struct S {
  n: Int
}

struct Outer {
  inner: S
}

public fun assign(s: S) {
  s.n = 1
}

public fun add_assign(s: S) {
  s.n += 1
}

public fun subtract_assign(s: S) {
  s.n -= 1
}

public fun nested_assign(s: Outer) {
  s.inner.n = 1
}

