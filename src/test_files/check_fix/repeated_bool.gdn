public fun repeated_or(x: Bool, y: Bool): Bool {
  x || y || x
}

public fun repeated_and(x: Bool, y: Bool): Bool {
  x && y && x
}

public fun repeated_paren(a: Bool, b: Bool): Bool {
  (a || b) || a
}

public fun repeated_or_three(b: Bool): Bool {
  b || b || b
}

public fun repeated_and_three(b: Bool): Bool {
  b && b && b
}

public fun unused_duplicate(b: Bool): Bool {
  b || b
  b
}

