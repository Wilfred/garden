  assert(render("_foo_", None, None) == "<p><em>foo</em></p>")
  assert(render("__foo__", None, None) == "<p><strong>foo</strong></p>")
}

test render_underscore_inside_word {
  assert(render("call or_throw here", None, None) == "<p>call or_throw here</p>")
  assert(render("a_b_c", None, None) == "<p>a_b_c</p>")
}

test render_backslash_escape {
  assert(render("a \\* b", None, None) == "<p>a * b</p>")
  assert(render("\\`foo\\`", None, None) == "<p>`foo`</p>")
  assert(render("\\[foo](bar)", None, None) == "<p>[foo](bar)</p>")
  assert(render("a \\\\ b", None, None) == "<p>a \\ b</p>")
}

test render_backslash_before_other_char {
  assert(render("a \\n b", None, None) == "<p>a \\n b</p>")
}

test render_autolink {
  let expected = "<p><a href=\"https://example.com\">https://example.com</a></p>"
  assert(render("<https://example.com>", None, None) == expected)
}

test render_bare_url {
  let expected = "<p>see <a href=\"https://example.com\">https://example.com</a>.</p>"
  assert(render("see https://example.com.", None, None) == expected)
