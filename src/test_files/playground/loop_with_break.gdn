let flavors = ["Mint", "Vanilla"]

// Break should still give us a loop that evaluates to Unit.
for flavor in flavors {
  if flavor == "Mint" {
    break
  }
}

// args: playground-run
// expected stdout:
// {"prelude_types":["Bool","Dict","Float","Fun","Int","List","Namespace","NoValue","Option","Path","PathInfo","Result","String","Tuple","Unit"]}
// {"error":null,"value":"Unit","type":"Unit"}
