// Good.
let _ = Dict[]

// Bad: undefined key.
let _ = Dict[no_such => 1]

// Bad: undefined value.
let _ = Dict["foo" => no_such2]

// Bad: key isn't a string.
let _ = Dict[1 => 2]

// Good: all values the same type.
let _ = Dict["x" => 1, "y" => 2]
let _ = Dict["x" => "xx", "y" => "yy"]

// Bad: mixed value types.
let _ = Dict["x" => 1, "y" => ""]

