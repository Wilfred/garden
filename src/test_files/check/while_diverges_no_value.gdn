// A `while True` loop with no `break` never produces a value, so it
// can occur where any type is expected.
public fun forever(): Int {
  while True {
    println("looping")
  }
}

// A `break` in a nested loop doesn't stop the outer loop diverging.
public fun forever_nested(): Int {
  while True {
    while True {
      break
    }
  }
}

// A loop with a `break` terminates, so it has type `Unit`.
public fun with_break(): Int {
  while True {
    break
  }
}

// A loop whose condition isn't `True` terminates, so it has type
// `Unit`.
public fun with_cond(): Int {
  let b = True
  while b {
    b = False
  }
}

