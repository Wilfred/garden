enum Foo {
  One,
  Two,
  Three,
}

{
  match One {
    One => [],
    Two => throw(""),
    Three => {
      "stuff"
    },
  }
}

public fun bar(): Int {
  match One {
    One => "wrong",
    Two => "wrong too",
    Three => {
      // not wrong
      123
    },
  }
}

