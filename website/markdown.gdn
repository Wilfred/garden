import "__prelude.gdn" as prelude
import "__reflect.gdn" as reflect

import "./log.gdn" as log
import "./operators.gdn" as ops

enum MarkdownPart {
  Heading(String),
  Paragraph(String),
  CodeBlock(Snippet),
  ListBlock(MarkdownList),
  BlockQuote(List<MarkdownPart>),
  ThematicBreak,
}

/// A bullet or numbered list, whose items may contain further lists.
struct MarkdownList {
  ordered: Bool,
  /// The number written on the first item of an ordered list.
  start: Int,
  items: List<ListItem>,
}

struct ListItem {
  content: String,
  sublist: Option<MarkdownList>,
}

/// The kind of lines currently being gathered for the next part.
enum SectionKind {
  TextLines,
  ListLines,
  QuoteLines,
}

struct Snippet {
  labels: List<String>,
  title: Option<String>,
  content: String,
  file: Option<Path>,
}

fun finish_section(
  kind: SectionKind,
  current_section: List<String>,
  file: Option<Path>,
): MarkdownPart {
  match kind {
    ListLines => ListBlock(parse_list(current_section))
    QuoteLines => BlockQuote(parse_markdown(quoted_src(current_section), file))
    TextLines => Paragraph("\n".join(current_section))
  }
}

/// Remove the `> ` marker from each line of a blockquote.
fun quoted_src(lines: List<String>): String {
  let quoted_lines: List<String> = []
  for line in lines {
    let quoted_line = line.trim_left().strip_prefix(">")
    quoted_lines = quoted_lines.append(quoted_line.strip_prefix(" "))
  }

  "\n".join(quoted_lines)
}

test quoted_src {
  assert(quoted_src(["> foo", ">bar", ">"]) == "foo\nbar\n")
}

/// A list item marker, such as `* ` or `12. `, with the text after it.
struct ListMarker {
  indent: Int,
  ordered: Bool,
  /// The number written on an ordered item, or 1 for a bullet.
  number: Int,
  content: String,
}

fun leading_spaces(line: String): Int {
  let count = 0
  while line.substring(count, count + 1) == " " {
    count += 1
  }

  count
}

test leading_spaces {
  assert(leading_spaces("foo") == 0)
  assert(leading_spaces("  foo") == 2)
  assert(leading_spaces("  ") == 2)
}

fun is_digit(c: String): Bool {
  (c != "") && "0123456789".contains(c)
}

/// Parse the `* ` or `1. ` marker at the start of a list item.
fun parse_list_marker(line: String): Option<ListMarker> {
  let indent = leading_spaces(line)
  let rest = line.substring(indent, line.len())

  if (rest.starts_with("* ") || rest.starts_with("- ")) || rest.starts_with("+ ") {
    let content = rest.substring(2, rest.len()).trim_left()
    return Some(ListMarker{ indent: indent, ordered: False, number: 1, content: content })
  }

  let digits = ""
  while is_digit(rest.substring(digits.len(), digits.len() + 1)) {
    digits = digits ^ rest.substring(digits.len(), digits.len() + 1)
  }

  let after_digits = rest.substring(digits.len(), rest.len())
  if not(after_digits.starts_with(". ") || after_digits.starts_with(") ")) {
    return None
  }

  match digits.as_int() {
    Some(number) => {
      let content = after_digits.substring(2, after_digits.len()).trim_left()
      Some(ListMarker{ indent: indent, ordered: True, number: number, content: content })
    }
    None => None
  }
}

test parse_list_marker {
  assert(parse_list_marker("* foo") == Some(ListMarker{ indent: 0, ordered: False, number: 1, content: "foo" }))
  assert(parse_list_marker("- foo") == Some(ListMarker{ indent: 0, ordered: False, number: 1, content: "foo" }))
  assert(parse_list_marker("+ foo") == Some(ListMarker{ indent: 0, ordered: False, number: 1, content: "foo" }))
  assert(parse_list_marker("  * foo") == Some(ListMarker{ indent: 2, ordered: False, number: 1, content: "foo" }))
  assert(parse_list_marker("3. foo") == Some(ListMarker{ indent: 0, ordered: True, number: 3, content: "foo" }))
  assert(parse_list_marker("3) foo") == Some(ListMarker{ indent: 0, ordered: True, number: 3, content: "foo" }))

  assert(parse_list_marker("foo") == None)
  assert(parse_list_marker("*foo") == None)
  assert(parse_list_marker("3.foo") == None)
  assert(parse_list_marker("-") == None)
}

/// Build a list from consecutive list item lines, nesting items that
/// are indented relative to the first item.
fun parse_list(lines: List<String>): MarkdownList {
  let markers: List<ListMarker> = []
  for line in lines {
    match parse_list_marker(line) {
      Some(marker) => {
        markers = markers.append(marker)
      }
      None => {}
    }
  }

  build_list(markers)
}

fun build_list(markers: List<ListMarker>): MarkdownList {
  let (ordered, start, base_indent) = match markers.first() {
    Some(marker) => (marker.ordered, marker.number, marker.indent)
    None => (False, 1, 0)
  }

  let items: List<ListItem> = []
  let current_content: Option<String> = None
  let nested: List<ListMarker> = []

  for marker in markers {
    if marker.indent > base_indent {
      nested = nested.append(marker)
    } else {
      match current_content {
        Some(content) => {
          items = items.append(ListItem{ content: content, sublist: build_sublist(nested) })
        }
        None => {}
      }

      nested = []
      current_content = Some(marker.content)
    }
  }

  match current_content {
    Some(content) => {
      items = items.append(ListItem{ content: content, sublist: build_sublist(nested) })
    }
    None => {}
  }

  MarkdownList{ ordered: ordered, start: start, items: items }
}

fun build_sublist(markers: List<ListMarker>): Option<MarkdownList> {
  if markers.is_empty() {
    None
  } else {
    Some(build_list(markers))
  }
}

/// Does `line` start a list that is separate from the items already
/// gathered in `section`? A bullet list and a numbered list at the
/// same indentation are distinct lists.
fun starts_new_list(section: List<String>, line: String): Bool {
  let marker = match parse_list_marker(line) {
    Some(marker) => marker
    None => { return True }
  }

  let first_line = match section.first() {
    Some(first_line) => first_line
    None => { return True }
  }

  match parse_list_marker(first_line) {
    Some(first_marker) => {
      (marker.indent <= first_marker.indent) && (marker.ordered != first_marker.ordered)
    }
    None => True
  }
}

/// Parse the text after the ``` on markdown blocks.
//
/// These labels are generally space-separated, but may contain double quotes.
//
/// For example:
//
/// label1 label2 foo:"label three"
fun parse_labels(src: String): List<String> {
  let labels: List<String> = []

  let s = src
  while s != "" {
    let word = ""
    match s.index_of(" ") {
      Some(i) => {
        word = s.substring(0, i)
        s = s.substring(i + 1, s.len())
      }
      None => {
        labels = labels.append(s)
        break
      }
    }

    if word.contains("\"") {
      match s.index_of("\"") {
        Some(i) => {
          word = word ^ " " ^ s.substring(0, i + 1)
          s = s.substring(i + 1, s.len())
        }
        None => {}
      }
    }

    labels = labels.append(word)
  }

  labels
}

fun parse_labels_and_title(src: String): (Option<String>, List<String>) {
  let all_labels = parse_labels(src)

  let labels: List<String> = []
  let title: Option<String> = None
  for label in all_labels {
    if label.starts_with("title:") {
      title = Some(label.strip_prefix("title:").strip_prefix("\"").strip_suffix("\""))
    } else {
      labels = labels.append(label)
    }
  }

  (title, labels)
}

fun parse_markdown(src: String, file: Option<Path>): List<MarkdownPart> {
  let parts: List<MarkdownPart> = []
  let current_section: List<String> = []

  let in_code_block = False
  let section_kind = TextLines

  for line in src.lines() {
    if (line == "") && current_section.is_empty() {
      continue
    }

    if line.starts_with("```") {
      if not(in_code_block) && current_section.is_non_empty() {
        parts = parts.append(finish_section(section_kind, current_section, file))
        section_kind = TextLines

        current_section = []
      }

      current_section = current_section.append(line)

      if in_code_block {
        // Just finished the code block.
        let label_str = current_section.first().or_throw().strip_prefix("```")
        let (title, labels) = parse_labels_and_title(label_str)

        let content = "\n".join(current_section.slice(1, -1))

        let snippet = Snippet{
          labels: labels,
          title: title,
          content: content,
          file: file,
        }

        parts = parts.append(CodeBlock(snippet))
        current_section = []
        in_code_block = False
      } else {
        in_code_block = True
      }
    } else if in_code_block {
      current_section = current_section.append(line)
    } else if ((line == "---") || (line == "***")) || (line == "___") {
      if current_section.is_non_empty() {
        parts = parts.append(finish_section(section_kind, current_section, file))
        section_kind = TextLines

        current_section = []
      }

      parts = parts.append(ThematicBreak)
    } else if line.starts_with("#") {
      if current_section.is_non_empty() {
        parts = parts.append(finish_section(section_kind, current_section, file))
        section_kind = TextLines

        current_section = []
      }

      parts = parts.append(Heading(line))
    } else if parse_list_marker(line).is_some() {
      if section_kind == ListLines {
        if starts_new_list(current_section, line) {
          parts = parts.append(finish_section(section_kind, current_section, file))
          current_section = []
        }
      } else {
        if current_section.is_non_empty() {
          parts = parts.append(finish_section(section_kind, current_section, file))
          current_section = []
        }

        section_kind = ListLines
      }

      current_section = current_section.append(line)
    } else if line.trim_left().starts_with(">") {
      if section_kind != QuoteLines {
        if current_section.is_non_empty() {
          parts = parts.append(finish_section(section_kind, current_section, file))
          current_section = []
        }

        section_kind = QuoteLines
      }

      current_section = current_section.append(line)
    } else if line == "" {
      parts = parts.append(finish_section(section_kind, current_section, file))
      section_kind = TextLines

      current_section = []
    } else {
      if section_kind != TextLines {
        parts = parts.append(finish_section(section_kind, current_section, file))
        section_kind = TextLines

        current_section = []
      }

      current_section = current_section.append(line)
    }
  }

  if current_section.is_non_empty() {
    parts = parts.append(finish_section(section_kind, current_section, file))
  }

  parts
}

/// Render a "# Foo" heading.
fun render_heading(src: String, self_url: Option<String>): String {
  let h_count = 0

  let content = src
  while content.starts_with("#") {
    h_count += 1
    content = content.strip_prefix("#")
  }

  if (h_count > 6) || not(content.starts_with(" ")) {
    return "<p>" ^ src ^ "</p>"
  }

  let open_tag = "<h" ^ string_repr(h_count) ^ ">"
  let close_tag = "</h" ^ string_repr(h_count) ^ ">"

  open_tag ^ render_inline(content.trim(), self_url) ^ close_tag
}

/// We want to find " < ", which requires trailing whitespace on the
/// previous lexeme as well as the < lexeme.
fun lex_with_ranges(s: String): List<(Int, Int, String)> {
  let items: List<(Int, Int, String)> = []

  let lexemes = reflect::lex(s)

  for (i, idx_and_tok) in lexemes.enumerate() {
    let (start_idx, tok) = idx_and_tok

    let end_idx = match lexemes.get(i + 1) {
      Some((next_idx, _)) => {
        next_idx
      }
      None => s.len()
    }

    items = items.append((start_idx, end_idx, tok))
  }

  items
}

fun render_code_block(snippet: Snippet, self_url: Option<String>): String {
  let is_garden = snippet.labels.is_empty() || snippet.labels.contains("garden")

  let (inner, output_div) = if is_garden {
    (render_garden_code(snippet, self_url), "<div class=\"snippet-output\" hidden></div>")
  } else {
    ("<code>" ^ escape_angle_brackets(snippet.content) ^ "</code>", "")
  }

  let buttons = if is_garden && (snippet.title != Some("Source Code")) {
    "<button class=\"run-snippet\">Run</button><button class=\"edit-snippet\">Edit</button>"
  } else {
    ""
  }

  let header = match snippet.title {
    Some(title) => {
      "<span class=\"code-title\">" ^ title ^ "</span>"
    }
    None => ""
  }

  "<div class=\"snippet\">" ^ header ^ "<pre>" ^ inner ^ "</pre>" ^ buttons ^ output_div ^ "</div>"
}

fun check_source(src: String, path: Option<Path>): Unit {
  let snippet_path = match path {
    Some(p) => p
    None => Path{ p: "__snippet.gdn" }
  }

  match reflect::check_snippet(src, snippet_path) {
    Ok(_) => {}
    Err(messages) => {
      let path_desc = match path {
        Some(p) => p.p ^ ": "
        None => ""
      }

      log::warn(path_desc ^ "Found an error when checking: " ^ src)
      for message in messages {
        log::info("  " ^ message)
      }
    }
  }
}

fun render_garden_code(snippet: Snippet, self_url: Option<String>): String {
  if not(snippet.labels.contains("nocheck")) {
    check_source(snippet.content, snippet.file)

    // Check that the expected values comments type check too.
    for line in snippet.content.lines() {
      match line.split_once("//->") {
        Some((_before, after)) => {
          // `*exception*` is a special marker indicating that the
          // expression should throw an exception, not Garden source.
          if after.trim() != "*exception*" {
            check_source(after, snippet.file)
          }
        }
        None => {}
      }
    }
  }

  let keywords = reflect::keywords()
  let operators = reflect::operators()
  let prelude_funs = reflect::namespace_functions(prelude)
  let rendered_lines: List<String> = []

  for line in snippet.content.lines() {
    let rendered_line_parts: List<String> = []

    let prev_had_trailing_ws = False
    for (i, tup) in lex_with_ranges(line).enumerate() {
      let (start_idx, end_idx, tok) = tup
      let has_trailing_ws = start_idx + tok.len() < end_idx

      if i == 0 {
        rendered_line_parts = rendered_line_parts.append(line.substring(0, start_idx))
      }

      let part = line.substring(start_idx, end_idx)

      let rendered_part = if tok.starts_with("//") {
        "<span class=\"comment\">" ^ escape_angle_brackets(part) ^ "</span>"
      } else if tok.starts_with("\"") {
        "<span class=\"string\">" ^ escape_angle_brackets(part) ^ "</span>"
      } else if keywords.contains(tok) {
        let after_tok = part.substring(tok.len(), part.len())
        "<a class=\"keyword\" href=\"/keyword:" ^ tok ^ ".html\">" ^ tok ^ "</a>" ^ after_tok
      } else if operators.contains(tok) {
        if prev_had_trailing_ws && has_trailing_ws {
          let name = ops::url_safe_name(tok)
          let url = "/operator:" ^ name ^ ".html"

          // We want to distinguish `List<Int>`, where there isn't an
          // operator, from `1 < 2` where there is an operator.
          //
          // This is an imperfect heuristic because we're only using
          // the lexer. It would be better to expose the full parser
          // to userland Garden code.
          let after_tok = part.substring(tok.len(), part.len())

          if Some(url) == self_url {
            "<span class=\"operator\">" ^ escape_angle_brackets(tok) ^ "</span>" ^ after_tok
          } else {
            "<a class=\"operator\" href=\"" ^ url ^ "\">" ^ escape_angle_brackets(tok) ^ "</a>" ^ after_tok
          }
        } else {
          escape_angle_brackets(part)
        }
      } else if prelude_funs.contains(tok) {
        let after_tok = part.substring(tok.len(), part.len())
        let url = "/fun:__prelude.gdn::" ^ tok ^ ".html"

        if self_url == Some(url) {
          tok ^ after_tok
        } else {
          "<a href=\"" ^ url ^ "\">" ^ tok ^ "</a>" ^ after_tok
        }
      } else if looks_like_type(tok) {
        let after_tok = part.substring(tok.len(), part.len())
        let url = "/type:" ^ tok ^ ".html"

        if reflect::prelude_types().contains(tok) && (self_url != Some(url)) {
          "<a class=\"type\" href=\"" ^ url ^ "\">" ^ tok ^ "</a>" ^ after_tok
        } else {
          "<span class=\"type\">" ^ tok ^ "</span>" ^ after_tok
        }
      } else {
        escape_angle_brackets(part)
      }
      rendered_line_parts = rendered_line_parts.append(rendered_part)

      prev_had_trailing_ws = has_trailing_ws
    }

    rendered_lines = rendered_lines.append("".join(rendered_line_parts))
  }

  let inner_src = "\n".join(rendered_lines)
  "<code>" ^ inner_src ^ "</code>"
}

fun escape_angle_brackets(s: String): String {
  s.replace("<", "&lt;").replace(">", "&gt;")
}

/// A piece of inline markdown, in the order it occurs in the source.
enum InlinePart {
  /// Text with no markup left in it, so it is only HTML escaped.
  PlainText(String),
  LinkSrc(String),
  ImageSrc(String),
  /// A raw HTML tag, written through unchanged.
  HtmlTag(String),
  AutolinkUrl(String),
  StrongText(String),
  EmphasisText(String),
  CodeText(String),
}

/// Render a markdown string inside e.g. a paragraph or bullet.
fun render_inline(src: String, self_url: Option<String>): String {
  let parts: List<String> = []

  for piece in split_inline_parts(src) {
    let rendered = match piece {
      PlainText(text) => escape_angle_brackets(text)
      LinkSrc(link_src) => render_link(link_src)
      ImageSrc(image_src) => render_image(image_src)
      HtmlTag(tag) => tag
      AutolinkUrl(url) => render_autolink(url)
      StrongText(text) => render_strong(text)
      EmphasisText(text) => render_emphasis(text)
      CodeText(text) => render_inline_code(text, self_url)
    }

    parts = parts.append(rendered)
  }

  "".join(parts)
}

/// Render backticks inside a link.
fun render_link_backticks(src: String): String {
  let parts: List<String> = []

  let s = src
  while True {
    match s.split_once("`") {
      Some((before_backtick, after_backtick)) => {
        parts = parts.append(escape_angle_brackets(before_backtick))

        match after_backtick.split_once("`") {
          Some((between_backticks, after_closing_backtick)) => {
            parts = parts.append("<code>" ^ escape_angle_brackets(between_backticks) ^ "</code>")
            s = after_closing_backtick
          }
          None => {
            parts = parts.append(escape_angle_brackets(s))
            break
          }
        }
      }
      None => {
        parts = parts.append(escape_angle_brackets(s))
        break
      }
    }
  }

  "".join(parts)
}

/// The characters that a backslash can escape, so that they are shown
/// literally rather than treated as markup.
fun is_escapable(c: String): Bool {
  (c != "") && "!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~".contains(c)
}

fun is_word_char(c: String): Bool {
  (c != "") && "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789".contains(c)
}

/// Split `src` into inline parts, such as links, emphasis, inline
/// code and plain text.
fun split_inline_parts(src: String): List<InlinePart> {
  let parts: List<InlinePart> = []

  // Text that we have scanned past without finding markup.
  let pending = ""
  // The character before `s`, which decides whether an underscore
  // can start emphasis.
  let prev = ""

  let delimiters = ["[", "![", "<", "*", "_", "`", "\\", "http://", "https://"]

  let s = src
  while s != "" {
    let idx = match first_idx(s, delimiters) {
      Some(idx) => idx
      None => s.len()
    }

    pending = pending ^ s.substring(0, idx)
    if idx > 0 {
      prev = s.substring(idx - 1, idx)
    }
    s = s.substring(idx, s.len())

    if s == "" {
      break
    }

    match match_inline_part(s, prev) {
      Some((part, after)) => {
        if pending != "" {
          parts = parts.append(PlainText(pending))
          pending = ""
        }

        parts = parts.append(part)

        let consumed = s.len() - after.len()
        prev = s.substring(consumed - 1, consumed)
        s = after
      }
      None => {
        // Not markup after all, e.g. an underscore inside a word.
        pending = pending ^ s.substring(0, 1)
        prev = s.substring(0, 1)
        s = s.substring(1, s.len())
      }
    }
  }

  if pending != "" {
    parts = parts.append(PlainText(pending))
  }

  parts
}

/// Parse an inline construct at the start of `s`, returning the part
/// and the text after it. `prev` is the character before `s`.
fun match_inline_part(s: String, prev: String): Option<(InlinePart, String)> {
  if s.starts_with("\\") {
    let escaped = s.substring(1, 2)
    if is_escapable(escaped) {
      return Some((PlainText(escaped), s.substring(2, s.len())))
    }

    return None
  }

  if s.starts_with("`") {
    // `inline code` syntax.
    match s.substring(1, s.len()).split_once("`") {
      Some((inner, after)) => {
        return Some((CodeText(inner), after))
      }
      None => {
        return None
      }
    }
  }

  if s.starts_with("<") {
    match split_on_terminator(s, ">") {
      Some((tag, after)) => {
        let inner = tag.strip_prefix("<").strip_suffix(">")
        if is_url(inner) {
          return Some((AutolinkUrl(inner), after))
        }

        return Some((HtmlTag(tag), after))
      }
      None => {
        return None
      }
    }
  }

  if is_url(s) {
    // A bare URL written without any markup around it.
    if is_word_char(prev) {
      return None
    }

    let url = take_url(s)
    return Some((AutolinkUrl(url), s.substring(url.len(), s.len())))
  }

  if s.starts_with("![") || s.starts_with("[") {
    match split_markdown_link(s) {
      Some((link_src, after)) => {
        if s.starts_with("!") {
          return Some((ImageSrc(link_src), after))
        }

        return Some((LinkSrc(link_src), after))
      }
      None => {
        // We saw malformed syntax, e.g. an unfinished link `[foo](bar`.
        return None
      }
    }
  }

  if s.starts_with("_") {
    // Underscores only start emphasis at the start of a word, so
    // that `snake_case` names are left alone.
    if is_word_char(prev) {
      return None
    }

    if s.starts_with("__") {
      match split_emphasis(s.substring(2, s.len()), "__") {
        Some((inner, after)) => {
          return Some((StrongText(inner), after))
        }
        None => {}
      }
    }

    match split_emphasis(s.substring(1, s.len()), "_") {
      Some((inner, after)) => {
        return Some((EmphasisText(inner), after))
      }
      None => {
        return None
      }
    }
  }

  // A **strong** or *emphasis* substring. For simplicity, we assume
  // this does not nest with links. This doesn't match the commonmark
  // spec, but it covers the common cases.
  if s.starts_with("**") {
    match s.substring(2, s.len()).split_once("**") {
      Some((inner, after)) => {
        return Some((StrongText(inner), after))
      }
      None => {}
    }
  }

  if s.starts_with("*") {
    match s.substring(1, s.len()).split_once("*") {
      Some((inner, after)) => {
        return Some((EmphasisText(inner), after))
      }
      None => {
        return None
      }
    }
  }

  None
}

/// Find the closing `delimiter` of underscore emphasis in `s`. The
/// closing delimiter must end a word, so that `foo_bar_baz` is not
/// treated as emphasis.
fun split_emphasis(s: String, delimiter: String): Option<(String, String)> {
  if s.starts_with(" ") {
    return None
  }

  let inner = ""
  let rest = s
  while rest != "" {
    if rest.starts_with(delimiter) {
      let after = rest.substring(delimiter.len(), rest.len())
      if not(is_word_char(after.substring(0, 1))) && not(inner.ends_with(" ")) {
        return Some((inner, after))
      }
    }

    inner = inner ^ rest.substring(0, 1)
    rest = rest.substring(1, rest.len())
  }

  None
}

test split_emphasis {
  assert(split_emphasis("foo_ bar", "_") == Some(("foo", " bar")))
  assert(split_emphasis("foo_bar_ baz", "_") == Some(("foo_bar", " baz")))
  assert(split_emphasis("foo_bar", "_") == None)
  assert(split_emphasis(" foo_", "_") == None)
}

fun is_url(s: String): Bool {
  s.starts_with("https://") || s.starts_with("http://")
}

/// The URL at the start of `s`, which ends at whitespace. Trailing
/// punctuation is excluded, so a URL at the end of a sentence does
/// not swallow the full stop.
fun take_url(s: String): String {
  let url = ""
  let rest = s
  while rest != "" {
    let c = rest.substring(0, 1)
    if " \t<>\"`".contains(c) {
      break
    }

    url = url ^ c
    rest = rest.substring(1, rest.len())
  }

  while url != "" {
    let last = url.substring(url.len() - 1, url.len())
    let is_unmatched_paren = (last == ")") && not(url.contains("("))

    if ".,;:!?".contains(last) || is_unmatched_paren {
      url = url.substring(0, url.len() - 1)
    } else {
      break
    }
  }

  url
}

test take_url {
  assert(take_url("https://example.com foo") == "https://example.com")
  assert(take_url("https://example.com.") == "https://example.com")
  assert(take_url("https://example.com/a_(b)") == "https://example.com/a_(b)")
  assert(take_url("https://example.com)") == "https://example.com")
}

/// If `s` contains `terminator`, return the string up to the
/// terminator (inclusive), and the string beyond it.
fun split_on_terminator(s: String, terminator: String): Option<(String, String)> {
  match s.split_once(terminator) {
    Some((before, after)) => {
      Some((before ^ terminator, after))
    }
    None => None,
  }
}

/// Split a markdown link or image from the start of `s`.
//
/// ```
/// split_markdown_link("[link text](url) rest") // Some(("[link text](url)", " rest"))
/// ```
fun split_markdown_link(s: String): Option<(String, String)> {
  if not(s.starts_with("[")) && not(s.starts_with("![")) {
    return None
  }

  // Find the closing ] of the link text
  let close_bracket_idx = match s.index_of("](") {
    Some(i) => i
    None => return None
  }

  // Find the matching ) for the URL part
  match s.substring(close_bracket_idx, s.len()).index_of(")") {
    Some(url_close_idx) => {
      let link_end = close_bracket_idx + url_close_idx + 1

      let link_part = s.substring(0, link_end)
      let remaining = s.substring(link_end, s.len())
      Some((link_part, remaining))
    }
    None => None
  }
}

test split_on_terminator {
  assert(split_on_terminator("abc", "b") == Some(("ab", "c")))
}

test split_markdown_link {
  assert(split_markdown_link("[foo](bar.html)") == Some(("[foo](bar.html)", "")))
  assert(split_markdown_link("[foo (bar)](baz.html)") == Some(("[foo (bar)](baz.html)", "")))
  assert(split_markdown_link("[foo](bar.html) remaining") == Some(("[foo](bar.html)", " remaining")))
  assert(split_markdown_link("not a link") == None)
  assert(split_markdown_link("[unclosed") == None)
}

/// If `s` contains any of the items in `substrings`, return the index
/// of the first match.
fun first_idx(s: String, substrings: List<String>): Option<Int> {
  let indices: List<Int> = []
  for char in substrings {
    match s.index_of(char) {
      Some(idx) => {
        indices = indices.append(idx)
      }
      None => {}
    }
  }

  min(indices)
}

test first_idx {
  assert(first_idx("abc", []) == None)
  assert(first_idx("abc", ["x"]) == None)
  assert(first_idx("abc", ["c", "b"]) == Some(1))
}

fun min(items: List<Int>): Option<Int> {
  let smallest = match items.first() {
    Some(item) => item,
    None => { return None }
  }

  for item in items {
    if item < smallest {
      smallest = item
    }
  }

  Some(smallest)
}

test min {
  assert(min([]) == None)
  assert(min([1]) == Some(1))
  assert(min([1, 0, 2]) == Some(0))
}

fun render_link(src: String): String {
  assert(src.starts_with("["))

  match src.index_of("]") {
    Some(i) => {
      let link_text = src.substring(1, i)
      let link_url = src.substring(i + 2, src.len() - 1)
      "<a href=\"" ^ link_url ^ "\">" ^ render_link_backticks(link_text) ^ "</a>"
    }
    None => src
  }
}

fun render_image(src: String): String {
  assert(src.starts_with("!["))

  match src.index_of("]") {
    Some(i) => {
      let image_descr = src.substring(2, i)
      let image_url = src.substring(i + 2, src.len() - 1)
      "<img src=\"" ^ image_url ^ "\" alt=\"" ^ image_descr ^ "\" />"
    }
    None => src
  }
}

fun render_autolink(url: String): String {
  "<a href=\"" ^ url ^ "\">" ^ escape_angle_brackets(url) ^ "</a>"
}

fun render_inline_code(inner: String, self_url: Option<String>): String {
  let rendered = "<code>" ^ escape_angle_brackets(inner) ^ "</code>"
  let url: Option<String> = None

  if reflect::operators().contains(inner) {
    let operator_url = "/operator:" ^ ops::url_safe_name(inner) ^ ".html"
    if not(inner.ends_with("=") && (inner.len() > 1)) {
      // Don't linkify += or !=, as they redirect to + and == respectively.
      // TODO: track redirects properly.
      url = Some(operator_url)
    }
  }

  if reflect::prelude_types().contains(inner) {
    url = Some("/type:" ^ inner ^ ".html")
  }

  if inner.ends_with("()") {
    let fun_name = inner.strip_suffix("()")
    let prelude_funs = reflect::namespace_functions(prelude)
    if prelude_funs.contains(fun_name) {
      url = Some("/fun:__prelude.gdn::" ^ fun_name ^ ".html")
    }
  }

  match url {
    Some(url) => {
      if self_url != Some(url)  {
        rendered = "<a href=\"" ^ url ^ "\"><code>" ^ inner ^ "</code></a>"
      }
    }
    None => {}
  }

  rendered
}

fun render_strong(inner: String): String {
  "<strong>" ^ escape_angle_brackets(inner) ^ "</strong>"
}

fun render_emphasis(inner: String): String {
  "<em>" ^ escape_angle_brackets(inner) ^ "</em>"
}

fun render_paragraph(src: String, self_url: Option<String>): String {
  "<p>" ^ render_inline(src, self_url) ^ "</p>"
}

fun render_list(list: MarkdownList, self_url: Option<String>): String {
  let rendered_items: List<String> = []
  for item in list.items {
    let rendered_item = render_inline(item.content, self_url)

    match item.sublist {
      Some(sublist) => {
        rendered_item = rendered_item ^ "\n" ^ render_list(sublist, self_url)
      }
      None => {}
    }

    rendered_items = rendered_items.append("<li>" ^ rendered_item ^ "</li>")
  }

  let (open_tag, close_tag) = if list.ordered {
    let start_attr = if list.start == 1 {
      ""
    } else {
      " start=\"" ^ string_repr(list.start) ^ "\""
    }

    ("<ol" ^ start_attr ^ ">", "</ol>")
  } else {
    ("<ul>", "</ul>")
  }

  open_tag ^ "\n" ^ "\n".join(rendered_items) ^ "\n" ^ close_tag
}

fun render_blockquote(parts: List<MarkdownPart>, self_url: Option<String>): String {
  "<blockquote>\n" ^ render_parts(parts, self_url) ^ "\n</blockquote>"
}

public fun render(src: String, file: Option<Path>, self_url: Option<String>): String {
  render_parts(parse_markdown(src, file), self_url)
}

fun render_parts(parts: List<MarkdownPart>, self_url: Option<String>): String {
  let html_parts: List<String> = []

  for part in parts {
    match part {
      Heading(heading) => {
        html_parts = html_parts.append(render_heading(heading, self_url))
      }
      Paragraph(paragraph) => {
        html_parts = html_parts.append(render_paragraph(paragraph, self_url))
      }
      CodeBlock(code) => {
        html_parts = html_parts.append(render_code_block(code, self_url))
      }
      ListBlock(list) => {
        html_parts = html_parts.append(render_list(list, self_url))
      }
      BlockQuote(quoted_parts) => {
        html_parts = html_parts.append(render_blockquote(quoted_parts, self_url))
      }
      ThematicBreak => {
        html_parts = html_parts.append("<hr />")
      }
    }
  }

  "\n".join(html_parts)
}

test render_paragraph_newlines {
  assert(render("foo\nbar", None, None) == "<p>foo\nbar</p>")
}

test render_headings {
  assert(render("# foo", None, None) == "<h1>foo</h1>")
  assert(render("#  foo ", None, None) == "<h1>foo</h1>")

  assert(render("## foo", None, None) == "<h2>foo</h2>")
  assert(render("###### foo", None, None) == "<h6>foo</h6>")

  assert(render("#foo", None, None) == "<p>#foo</p>")
  assert(render("####### foo", None, None) == "<p>####### foo</p>")
}

test render_paragraph {
  assert(render("foo bar", None, None) == "<p>foo bar</p>")
}

test render_paragraph_escape_angle_brackets {
  assert(render("foo bar<", None, None) == "<p>foo bar&lt;</p>")
}

test render_paragraph_after_heading {
  assert(render("# foo\n\nbar", None, None) == "<h1>foo</h1>\n<p>bar</p>")
}

test render_backtick {
  assert(render("`foo`", None, None) == "<p><code>foo</code></p>")
}

test render_backtick_escape_angle_brackets {
  assert(render("`foo<`", None, None) == "<p><code>foo&lt;</code></p>")
}

test render_backtick_angle_brackets {
  assert(render("`List<T>`", None, None) == "<p><code>List&lt;T&gt;</code></p>")
}

test render_strong_escape_angle_brackets {
  assert(render("*foo<*", None, None) == "<p><em>foo&lt;</em></p>")
}

test render_backtick_in_heading {
  assert(render("# `foo`", None, None) == "<h1><code>foo</code></h1>")
}

test render_link {
  assert(render("[foo](example.com)", None, None) == "<p><a href=\"example.com\">foo</a></p>")
}

test render_malformed_link {
  assert(render("foo ) [ bar", None, None) == "<p>foo ) [ bar</p>")
}

test render_backtick_in_link {
  assert(render("[`foo` bar](#)", None, None) == "<p><a href=\"#\"><code>foo</code> bar</a></p>")
}

test render_link_with_parentheses {
  assert(render("[foo (bar)](baz.html)", None, None) == "<p><a href=\"baz.html\">foo (bar)</a></p>")
}

test render_triple_backtick {
  assert(render("```nocheck\nfoo\nbar\n```", None, None) == "<div class=\"snippet\"><pre><code>foo\nbar</code></pre></div>")
}

test render_triple_backtick_escape_html {
  assert(render("```nocheck\nfoo <bar>\n```", None, None) == "<div class=\"snippet\"><pre><code>foo &lt;bar&gt;</code></pre></div>")
}

test render_triple_backtick_blank_line {
  assert(render("```nocheck\nfoo\n\nbar\n```", None, None) == "<div class=\"snippet\"><pre><code>foo\n\nbar</code></pre></div>")
}

test render_triple_backtick_keyword {
  assert(render("```garden nocheck\nfun foo\n```", None, None) == "<div class=\"snippet\"><pre><code><a class=\"keyword\" href=\"/keyword:fun.html\">fun</a> foo</code></pre><button class=\"run-snippet\">Run</button><button class=\"edit-snippet\">Edit</button><div class=\"snippet-output\" hidden></div></div>")
}

test render_triple_backtick_comment {
  assert(render("```garden nocheck\nfoo // bar\n```", None, None) == "<div class=\"snippet\"><pre><code>foo <span class=\"comment\">// bar</span></code></pre><button class=\"run-snippet\">Run</button><button class=\"edit-snippet\">Edit</button><div class=\"snippet-output\" hidden></div></div>")
}

test render_asterisk_bullet {
  assert(render("* foo\n* bar", None, None) == "<ul>
<li>foo</li>
<li>bar</li>
</ul>")
}

test render_asterisk_bullet_with_content_after {
  assert(render("* foo\n\nbar", None, None) == "<ul>
<li>foo</li>
</ul>
<p>bar</p>")
}

test render_dash_bullet {
