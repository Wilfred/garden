public fun foo(items: List<Int>) {
  // Good
  for x in items {
    let _ = x + 1
  }

  // Good
  for (x, y) in [(1, 2)] {
    let _ = x + y
  }

  // Bad
  for (x, y) in items {
    let _ = x + y
  }
}

